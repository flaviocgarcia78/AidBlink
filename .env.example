# Public base URL of the running app (used to build links and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana network. Use devnet for the hackathon demo.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public address that receives contributions (treasury). No private key needed
# for the app to receive funds. Duplicated as NEXT_PUBLIC_* so the browser can
# display it.
AIDBLINK_TREASURY_ADDRESS=11111111111111111111111111111111
NEXT_PUBLIC_TREASURY_ADDRESS=11111111111111111111111111111111

# AidBlink Anchor program (devnet) that records contributions on-chain.
# Source: programs/aidblink. Redeploying with a new keypair changes this value.
AIDBLINK_PROGRAM_ID=BsNDtwVsmxpMSnnoUiiadhjnRvxJ8huuZWZ5vcrFCrrg

# Secret used to sign one-time voucher tokens (HMAC-SHA256).
# Change this to a long random string. Never expose it to the client.
AIDBLINK_VOUCHER_SECRET=replace-with-a-long-random-secret

# Demo login that gates the organization dashboard (/admin) and the partner
# terminal (/redeem). Example users with safe defaults; change them for a real
# deployment. The session cookie is signed with AIDBLINK_AUTH_SECRET (falls
# back to the voucher secret). Set AIDBLINK_DEMO_HINTS=0 to hide the prefilled
# demo credentials on the login page.
AIDBLINK_ORG_USER=org@aidblink.demo
AIDBLINK_ORG_PASSWORD=aidblink-org
AIDBLINK_PARTNER_USER=parceiro@aidblink.demo
AIDBLINK_PARTNER_PASSWORD=aidblink-parceiro
AIDBLINK_AUTH_SECRET=replace-with-a-long-random-secret
AIDBLINK_DEMO_HINTS=1

# Illustrative SOL/USD rate used to convert contributions to benefit budgets.
# This is a fixed demo rate, not a live price feed.
NEXT_PUBLIC_SOL_USD_RATE=150

# OPTIONAL: server keypair (base58 secret key) used to anchor voucher
# redemptions on-chain via an SPL Memo transaction. Leave empty to disable
# on-chain anchoring. The account needs a little devnet SOL for fees.
AIDBLINK_ANCHOR_SECRET_KEY=
