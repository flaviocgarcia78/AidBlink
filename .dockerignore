# Dependencies and build output are rebuilt inside the image.
node_modules
.next
out
build

# Local demo state must not be baked into the image.
.data

# Secrets and local env files.
.env
.env.*
!.env.example

# Git and editor noise.
.git
.gitignore
.vscode
.idea
.DS_Store

# Docs are not needed at runtime.
docs
README.md

npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
tsconfig.tsbuildinfo
